{
  "name": "my-library",
  "version": "1.2.0",
  "description": "A sample library that demonstrates automatic documentation generation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "docs": "docs generate",
    "docs:build": "docs build"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["utility", "typescript", "zod"]
}
